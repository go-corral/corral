# mounts
ro-bind /opt
ro-bind /usr
ro-bind /etc/resolv.conf
ro-bind /etc/hosts
ro-bind /etc/ssl
ro-bind /etc/ca-certificates
ro-bind /etc/passwd
ro-bind /etc/group
ro-bind /etc/nsswitch.conf
ro-bind /etc/localtime
ro-bind /home/u/.gitconfig (try)
ro-bind /home/u/.gitignore_global (try)
ro-bind /home/u/.config/git (try)
ro-bind /home/u/.config/ccstatusline (try)
ro-bind /home/u/.config/corral (try)
ro-bind /home/u/.local/bin (try)
ro-bind /home/u/.local/share/uv (try)
bind /home/u/.claude
# symlinks
/bin -> usr/bin
/lib -> usr/lib
/lib64 -> usr/lib64
